{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safezone.ai/schemas/simulation-response.schema.json",
  "title": "SafeZoneSimulationResponse",
  "description": "CANONICAL SOURCE OF TRUTH: Simulation output payload produced by Deep's physics engine, processed by Vaibhav's backend, and rendered by AR's frontend.",
  "type": "object",
  "required": [
    "simulationId",
    "timestamp",
    "overallSeverity",
    "overallRiskScore",
    "hazardZones",
    "affectedAssets",
    "dominoPropagation",
    "escapeRoutesAssessment",
    "recommendedApproachDirection"
  ],
  "properties": {
    "simulationId": { "type": "string" },
    "requestId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "executionTimeMs": { "type": "number" },
    "overallSeverity": {
      "type": "string",
      "description": "Qualitative incident severity tier.",
      "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
    },
    "overallRiskScore": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 100.0,
      "description": "Composite plant risk index (0.0=minimal hazard, 100.0=maximum catastrophic multi-unit escalation)."
    },
    "summary": { "type": "string" },
    "hazardZones": {
      "type": "array",
      "description": "Iso-intensity threat contours generated by the physics model. Threshold values and units are computed and populated directly by the simulation engine.",
      "items": {
        "type": "object",
        "required": [
          "zoneId",
          "zoneType",
          "thresholdValue",
          "thresholdUnit",
          "severityLevel",
          "radiusMeters",
          "polygonCoordinates"
        ],
        "properties": {
          "zoneId": { "type": "string" },
          "zoneType": {
            "type": "string",
            "description": "Primary hazard mechanism generating this iso-zone contour.",
            "enum": ["THERMAL", "BLAST", "COMBINED"]
          },
          "thresholdValue": {
            "type": "number",
            "description": "Numerical cutoff threshold used by the simulation model to contour this zone."
          },
          "thresholdUnit": {
            "type": "string",
            "description": "Physical unit for thresholdValue (e.g. 'kW/m^2' for THERMAL, 'kPa' for BLAST).",
            "enum": ["kW/m^2", "kPa", "psi", "ppm", "INDEX"]
          },
          "severityLevel": {
            "type": "string",
            "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]
          },
          "radiusMeters": {
            "type": "number",
            "description": "Equivalent circular / maximum extent radius in meters."
          },
          "polygonCoordinates": {
            "type": "array",
            "description": "Wind-skewed or barrier-attenuated polygon boundary vertices in local meters relative to facility origin.",
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number", "description": "Meters east (+) of facility origin." },
                "y": { "type": "number", "description": "Meters north (+) of facility origin." }
              }
            }
          },
          "description": { "type": "string" }
        }
      }
    },
    "affectedAssets": {
      "type": "array",
      "description": "Per-asset impact evaluation. Failure probabilities and rupture times are theoretical, model-derived estimates based on vulnerability probit functions.",
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "name",
          "distanceMeters",
          "damageState",
          "failureProbabilityEstimate"
        ],
        "properties": {
          "assetId": { "type": "string" },
          "name": { "type": "string" },
          "distanceMeters": { "type": "number" },
          "peakThermalRadiationKwM2": { "type": "number", "default": 0.0 },
          "peakOverpressureKPa": { "type": "number", "default": 0.0 },
          "damageState": {
            "type": "string",
            "enum": ["INTACT", "MINOR_DAMAGE", "STRUCTURAL_DAMAGE", "TOTAL_LOSS"]
          },
          "failureProbabilityEstimate": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Model-derived estimate (probit-based) of equipment breach/rupture probability (0.0 to 1.0). Not an experimentally measured certainty."
          },
          "estimatedTimeToRuptureSeconds": {
            "type": "number",
            "description": "Model-derived estimate of time until thermal vessel failure under incident flux."
          },
          "damageSummary": { "type": "string" }
        }
      }
    },
    "dominoPropagation": {
      "type": "array",
      "description": "Sequential or probabilistic secondary cascade chain calculated by the risk model.",
      "items": {
        "type": "object",
        "required": [
          "stepOrder",
          "triggerAssetId",
          "targetAssetId",
          "mechanism",
          "escalationProbabilityEstimate",
          "estimatedDelaySeconds"
        ],
        "properties": {
          "stepOrder": { "type": "integer", "minimum": 1 },
          "triggerAssetId": { "type": "string" },
          "targetAssetId": { "type": "string" },
          "mechanism": {
            "type": "string",
            "enum": [
              "THERMAL_RADIATION_RUPTURE",
              "OVERPRESSURE_COLLAPSE",
              "DEBRIS_IMPACT",
              "POOL_FIRE_ENGULFMENT"
            ]
          },
          "escalationProbabilityEstimate": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Model-derived theoretical probability of secondary unit ignition/failure."
          },
          "estimatedDelaySeconds": { "type": "number", "minimum": 0.0 },
          "riskContribution": { "type": "string" }
        }
      }
    },
    "escapeRoutesAssessment": {
      "type": "array",
      "description": "Evacuation path safety classification against blast and thermal threshold intercepts.",
      "items": {
        "type": "object",
        "required": ["routeId", "name", "safetyStatus", "recommendation"],
        "properties": {
          "routeId": { "type": "string" },
          "name": { "type": "string" },
          "safetyStatus": {
            "type": "string",
            "enum": ["SAFE", "CAUTION", "UNSAFE"]
          },
          "maxThermalExposureKwM2": { "type": "number" },
          "maxOverpressureKPa": { "type": "number" },
          "cutoffDistanceAlongRouteMeters": {
            "type": "number",
            "description": "Distance in meters along the path where the route breaches safety thresholds."
          },
          "recommendation": { "type": "string" }
        }
      }
    },
    "recommendedApproachDirection": {
      "type": "object",
      "description": "First-responder approach guidance.",
      "required": ["bearingDegrees", "compassSector", "safetyRating", "rationale"],
      "properties": {
        "bearingDegrees": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 360.0,
          "description": "Optimal approach azimuth (direction to approach FROM, clockwise from True North)."
        },
        "compassSector": { "type": "string" },
        "safetyRating": { "type": "string", "enum": ["OPTIMAL", "ACCEPTABLE", "HAZARDOUS"] },
        "upwindOffsetDegrees": { "type": "number" },
        "rationale": { "type": "string" }
      }
    }
  }
}
